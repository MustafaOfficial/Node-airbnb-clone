<%- include('../partials/head') %>
    <%- include('../partials/nav') %>

        <body>
            <h1>You are on Home detail Page id <%= homeId%>
            </h1>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <div
                    class="group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col">
                    <!-- Image Container -->
                    <div class="relative w-full aspect-video bg-slate-100 overflow-hidden">
                        <img src="<%= home.photoUrl %>" alt="<%= home.name %>"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80';">
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex flex-col flex-grow justify-between">
                        <div>
                            <div
                                class="flex items-center gap-1.5 text-xs font-semibold text-rose-600 mb-1.5 uppercase tracking-wider">
                                <!-- Location Pin Icon -->
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span class="truncate">
                                    <%= home.location %>
                                </span>
                            </div>
                            <h4
                                class="text-lg font-bold text-slate-800 line-clamp-1 group-hover:text-rose-600 transition-colors">
                                <%= home.name %>
                            </h4>
                        </div>

                        <!-- Card Footer: Price -->
                        <div class="mt-4 pt-4 border-t border-slate-100">

                            <!-- Price -->
                            <div class="flex items-baseline justify-between">
                                <span class="text-xs text-slate-400 font-medium">Price</span>

                                <div class="text-right">
                                    <span class="text-xl font-extrabold text-slate-900">
                                        $<%= home.price %>
                                    </span>

                                    <span class="text-xs text-slate-500 font-normal">
                                        / night
                                    </span>
                                </div>
                            </div>

                            <!-- favorites Button -->
                            <%- include('../partials/favoritesButton', { home: home }) %>


                        </div>
                    </div>
                </div>
            </div>

        </body>

        </html>