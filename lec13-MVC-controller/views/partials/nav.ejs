<header class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <h1 class="text-rose-600 font-extrabold text-2xl tracking-tight">Air-BNB</h1>
        <nav class="flex items-center gap-3">
            <a href="/home"
                class="px-3 py-2 rounded-md text-sm font-semibold text-slate-600 <%= currentPage === 'home'? 'bg-rose-100': 'hover:bg-rose-100' %> transition-colors duration-150">Home</a>

            <a href="/host/add-home"
                class="px-3 py-2 rounded-md text-sm font-semibold text-slate-600 <%= currentPage === 'addHome'? 'bg-rose-100': 'hover:bg-rose-100' %> transition-colors duration-150">Add
                Home</a>
            <a href="/host/host-home-list"
                class="px-3 py-2 rounded-md text-sm font-semibold text-slate-600 <%= currentPage === 'host-home-list'? 'bg-rose-100': 'hover:bg-rose-100' %> transition-colors duration-150">Host
                Homes List</a>
            <a href="/bookings"
                class="px-3 py-2 rounded-md text-sm font-semibold text-slate-600 <%= currentPage === 'bookings'? 'bg-rose-100': 'hover:bg-rose-100' %> transition-colors duration-150">Bookings</a>
            <a href="/favourites"
                class="px-3 py-2 rounded-md text-sm font-semibold text-slate-600 <%= currentPage === 'favourites'? 'bg-rose-100': 'hover:bg-rose-100' %> transition-colors duration-150">Favourites</a>
        </nav>
    </div>
</header>