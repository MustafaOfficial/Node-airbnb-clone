<%- include('../partials/head') %>

    <body class="bg-slate-50 min-h-screen text-slate-800 antialiased">
        <!-- Header Navigation -->
        <%- include('../partials/nav') %>

            <!-- Main Content Area -->
            <main class="max-w-6xl mx-auto px-4 py-8 sm:py-12">
                <!-- Call to Action Banner -->
                <% if (addedHomes.length===0) { %>
                    <div
                        class="bg-white p-6 sm:p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center max-w-xl mx-auto mb-12">
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
                            Register Your Home
                        </h2>
                        <p class="text-slate-600 text-sm sm:text-base mb-6 max-w-sm">
                            Join our community of hosts. Earn extra income and welcome travelers from around the world.
                        </p>
                        <a href="/host/add-home"
                            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-xl font-semibold text-white bg-rose-600 hover:bg-rose-700 active:scale-95 transition-all duration-150 shadow-md shadow-rose-600/20 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
                            Add Home
                        </a>
                    </div>
                    <% } %>


                        <!-- Registered Homes Section -->
                        <div>
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
                                    Registered Homes
                                </h3>
                                <span class="text-sm font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
                                    <%= addedHomes.length %>
                                        <%= addedHomes.length===1 ? 'Home' : 'Homes' %>
                                </span>
                            </div>

                            <% if (addedHomes.length> 0) { %>
                                <!-- Cards Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                                    <% addedHomes.forEach(home=> { %>
                                        <div
                                            class="group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col">
                                            <!-- Image Container -->
                                            <div class="relative w-full aspect-video bg-slate-100 overflow-hidden">
                                                <img src="<%= home.photoUrl %>" alt="<%= home.name %>"
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80';">
                                            </div>

                                            <!-- Card Body -->
                                            <div class="p-5 flex flex-col flex-grow justify-between">
                                                <div>
                                                    <div
                                                        class="flex items-center gap-1.5 text-xs font-semibold text-rose-600 mb-1.5 uppercase tracking-wider">
                                                        <!-- Location Pin Icon -->
                                                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        </svg>
                                                        <span class="truncate">
                                                            <%= home.location %>
                                                        </span>
                                                    </div>
                                                    <h4
                                                        class="text-lg font-bold text-slate-800 line-clamp-1 group-hover:text-rose-600 transition-colors">
                                                        <%= home.name %>
                                                    </h4>
                                                    <% if (home.description) { %>
                                                        <p class="text-sm text-slate-600 mt-2 line-clamp-2">
                                                            <%= home.description %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- Card Footer: Price & Actions -->
                                                <div class="mt-4 pt-4 border-t border-slate-100">
                                                    <div class="flex items-baseline justify-between mb-3">
                                                        <span class="text-xs text-slate-400 font-medium">Price</span>
                                                        <div>
                                                            <span class="text-xl font-extrabold text-slate-900">$<%=
                                                                    home.price %></span>
                                                            <span class="text-xs text-slate-500 font-normal"> /
                                                                night</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <a href="/host/edit-home/<%=home.id%>?editing=true"
                                                            class="flex-1 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 active:scale-95 py-2 px-3 rounded-lg transition-all duration-150">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                stroke-width="2" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                            </svg>
                                                            Edit
                                                        </a>
                                                        <a href="/home/<%= home.id %>"
                                                            class="flex-1 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 active:scale-95 py-2 px-3 rounded-lg transition-all duration-150">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                stroke-width="2" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                            </svg>
                                                            Details
                                                        </a>
                                                        <form action="/host/delete-home/<%= home.id%>" method="post"
                                                            class="flex-1"
                                                            onsubmit="return confirm('Are you sure you want to delete this home?')">
                                                            <button type="submit"
                                                                class="w-full inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-red-600 bg-red-50 hover:bg-red-100 active:scale-95 py-2 px-3 rounded-lg transition-all duration-150">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                    stroke-width="2" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                </svg>
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div
                                        class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-200">
                                        <p class="text-slate-500 font-medium">No homes registered yet.</p>
                                    </div>
                                    <% } %>
                        </div>
            </main>
    </body>

    </html>