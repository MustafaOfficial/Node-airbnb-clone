<%- include('../partials/head') %>

    <body class="bg-slate-50 min-h-screen text-slate-800 antialiased">
        <!-- Header Navigation -->
        <%- include('../partials/nav') %>

            <!-- Main Content Area -->
            <main class="max-w-6xl mx-auto px-4 py-8 sm:py-12">

                <!-- Favourites Homes Section -->
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
                            Here are your Favourites
                        </h3>
                        <span class="text-sm font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
                            <%= favouriteHomes.length %>
                                <%= favouriteHomes.length===1 ? 'Home' : 'Homes' %>
                        </span>
                    </div>

                    <% if (favouriteHomes.length> 0) { %>
                        <!-- Cards Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% favouriteHomes.forEach(home=> { %>
                                <div
                                    class="group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col">
                                    <!-- Image Container -->
                                    <div class="relative w-full aspect-video bg-slate-100 overflow-hidden">
                                        <img src="<%= home.photoUrl %>" alt="<%= home.name %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80';">
                                    </div>

                                    <!-- Card Body -->
                                    <div class="p-5 flex flex-col flex-grow justify-between">
                                        <div>
                                            <div
                                                class="flex items-center gap-1.5 text-xs font-semibold text-rose-600 mb-1.5 uppercase tracking-wider">
                                                <!-- Location Pin Icon -->
                                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                </svg>
                                                <span class="truncate">
                                                    <%= home.location %>
                                                </span>
                                            </div>
                                            <h4
                                                class="text-lg font-bold text-slate-800 line-clamp-1 group-hover:text-rose-600 transition-colors">
                                                <%= home.name %>
                                            </h4>
                                            <% if (home.description) { %>
                                                <p class="text-sm text-slate-600 mt-2 line-clamp-2">
                                                    <%= home.description %>
                                                </p>
                                                <% } %>
                                        </div>

                                        <!-- Card Footer: Price & Actions -->
                                        <div class="mt-4 pt-4 border-t border-slate-100">
                                            <div class="flex items-baseline justify-between mb-3">
                                                <span class="text-xs text-slate-400 font-medium">Price</span>
                                                <div>
                                                    <span class="text-xl font-extrabold text-slate-900">$<%= home.price
                                                            %></span>
                                                    <span class="text-xs text-slate-500 font-normal"> / night</span>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <a href="/home/<%= home._id %>"
                                                    class="flex-1 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 active:scale-95 py-2 px-3 rounded-lg transition-all duration-150">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                        stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                    Details
                                                </a>
                                                <form action="/favourites/<%= home._id%>" method="post" class="flex-1">
                                                    <button type="submit"
                                                        class="w-full inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-red-600 bg-red-50 hover:bg-red-100 active:scale-95 py-2 px-3 rounded-lg transition-all duration-150">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                            stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                                        </svg>
                                                        Remove
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <!-- Empty State -->
                            <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-200">
                                <p class="text-slate-500 font-medium">No homes marked as favourite yet.</p>
                            </div>
                            <% } %>
                </div>
            </main>
    </body>

    </html>