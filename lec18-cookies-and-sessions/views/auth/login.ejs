<%- include('../partials/head') %>


    <body class="bg-slate-50 min-h-screen text-slate-800 antialiased">
        <!-- Header -->
        <%- include('../partials/nav') %>


            <!-- Main Content -->
            <main class="max-w-lg mx-auto px-4 py-10">
                <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-100">
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-1">
                        <%=editing? "Edit" :"Register"%> Your Home
                    </h2>

                    <form action="/login" method="POST" class="flex flex-col gap-4">

                        <input type="email" name="email" placeholder="Enter Email"
                            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition">
                        <input type="password" name="password" placeholder="Enter home Password"
                            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition">

                        <input type="submit" value="Login"
                            class="w-full py-2.5 rounded-xl font-semibold text-white bg-rose-600 hover:bg-rose-700 active:scale-95 transition-all duration-150 cursor-pointer shadow-md shadow-rose-600/20">

                    </form>
                </div>
            </main>
    </body>

    </html>